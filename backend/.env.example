# ── Рица backend environment ────────────────────────────────────────────────
# Скопируйте в .env и при необходимости отредактируйте.

# Порт API
PORT=3001

# URL фронтенда (для CORS)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL=postgresql://crudo:crudo_pass@localhost:5432/crudo?schema=public

# Учётная запись администратора по умолчанию (создаётся при prisma db seed)
ADMIN_EMAIL=admin@rica.local
ADMIN_PASSWORD=rica123456

# ── MAX уведомления (com.ms) ────────────────────────────────────────────────
# Базовый URL API MAX (замените на ваш endpoint)
MAX_API_URL=https://api.com.ms
# API-ключ вашего бота в MAX
MAX_API_KEY=your_max_api_key_here
# ID чата/канала, куда шлем уведомления о заказах
MAX_CHAT_ID=your_max_chat_id_here
