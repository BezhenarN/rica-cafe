# ── Crudo backend environment ───────────────────────────────────────────────
# Скопируйте в .env и при необходимости отредактируйте.

# Порт API
PORT=3001

# URL фронтенда (для CORS)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL=postgresql://crudo:crudo_pass@localhost:5432/crudo?schema=public

# Учётная запись администратора по умолчанию (создаётся при prisma db seed)
ADMIN_EMAIL=admin@crudo.local
ADMIN_PASSWORD=admin12345
