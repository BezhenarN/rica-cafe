{
  "buildCommand": "npm install && npm run prisma:generate && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "",
    "DATABASE_URL": "",
    "JWT_SECRET": "",
    "ADMIN_EMAIL": "",
    "ADMIN_PASSWORD": ""
  },
  "functions": {
    "src/app/api/health/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "src/app/api/auth/*/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "src/app/api/categories/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "src/app/api/products/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "src/app/api/pizza/options/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "src/app/api/orders/route.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "src/app/api/admin/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
