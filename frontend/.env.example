# Database — Vercel Postgres / Neon / any PostgreSQL
DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# JWT signing secret (≥ 32 chars recommended)
JWT_SECRET="change-me-to-a-long-random-string"

# JWT TTL (default 7d)
JWT_EXPIRES_IN="7d"

# Seed credentials
ADMIN_EMAIL="admin@ricacafe.ru"
ADMIN_PASSWORD="admin123456"

# Optional: R2 / Cloudflare S3 for image uploads
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
