# ── Crudo frontend environment ───────────────────────────────────────────────
# Скопируйте в .env.local

# Публичный URL API (для браузерных запросов). В dev используется /api-прокси Next.js,
# поэтому значение нужно только для production-сборки.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Внутренний URL бэкенда для server-side запросов и прокси rewrites (без /api).
BACKEND_URL=http://localhost:3001
